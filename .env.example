# Welmi Claude Proxy (consumes your Max plan, marginal cost €0)
EXPO_PUBLIC_CLAUDE_PROXY_URL=https://your-codespace.app.github.dev
EXPO_PUBLIC_CLAUDE_PROXY_KEY=replace_with_proxy_api_key

# GitHub assets repo (food DB + prompts + altstore manifest)
EXPO_PUBLIC_DATA_REPO_RAW=https://raw.githubusercontent.com/kevinmonin72/welmi-killer-data/main

# Fitness providers — register apps and paste credentials here
# Strava: https://www.strava.com/settings/api
EXPO_PUBLIC_STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=

# COROS: https://opena.coros.com/
EXPO_PUBLIC_COROS_CLIENT_ID=
COROS_CLIENT_SECRET=

# Oura: https://cloud.ouraring.com/oauth/applications
EXPO_PUBLIC_OURA_CLIENT_ID=
OURA_CLIENT_SECRET=

# Whoop: https://developer.whoop.com/
EXPO_PUBLIC_WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=

# Withings: https://developer.withings.com/
EXPO_PUBLIC_WITHINGS_CLIENT_ID=
WITHINGS_CLIENT_SECRET=
